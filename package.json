{
  "name": "@tn-figueiredo/cms",
  "version": "0.2.0",
  "description": "Reusable Next.js + Supabase CMS with MDX compile-on-save — the @tn-figueiredo ecosystem",
  "license": "MIT",
  "author": "Thiago Figueiredo <tnfigueiredotv@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/TN-Figueiredo/cms.git"
  },
  "bugs": {
    "url": "https://github.com/TN-Figueiredo/cms/issues"
  },
  "homepage": "https://github.com/TN-Figueiredo/cms#readme",
  "keywords": [
    "cms",
    "mdx",
    "nextjs",
    "supabase",
    "multi-tenant",
    "blog"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./code": {
      "types": "./dist/code.d.ts",
      "import": "./dist/code.js"
    },
    "./ring": {
      "types": "./dist/ring.d.ts",
      "import": "./dist/ring.js"
    },
    "./login": {
      "types": "./dist/login.d.ts",
      "import": "./dist/login.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "debug": "4.4.3",
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@tn-figueiredo/auth-nextjs": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "optionalDependencies": {
    "@shikijs/rehype": "4.0.2"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.103.3",
    "@testing-library/react": "16.3.2",
    "@tn-figueiredo/auth-nextjs": "2.2.0",
    "@types/debug": "4.1.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "happy-dom": "20.9.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "6.0.2",
    "vitest": "4.1.4",
    "vitest-axe": "^0.1.0"
  }
}
